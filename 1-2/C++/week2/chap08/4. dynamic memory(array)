#include <iostream>
#include <string>
using namespace std;
//dynamic memory

int main() {
	char* pGrades = NULL;
	int size;

	cout << "how mary grades to enter in?";
	cin >> size;
	pGrades = new char[size];

	for (int i = 0; i < size; i++) {
		cout << "enter Grade #" << i + 1 << ": ";
		cin >> pGrades[i];
	}
	for (int i = 0; i < size; i++) {
		cout << pGrades[i]<< " ";
	}

	delete[] pGrades;
	return 0;

}
